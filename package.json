{
  "name": "decktective",
  "version": "0.1.0",
  "type": "module",
  "description": "Build a weekly activity deck (PPTX) from a git repository by filling a .pptx template.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "satori": "^0.33.4"
  },
  "omp": {
    "extensions": [
      "./extensions/decktective.ts"
    ]
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/decktective.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "deck",
    "pptx",
    "weekly-report",
    "git"
  ]
}
